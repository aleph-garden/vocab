@prefix shapes: <https://w3id.org/aleph/garden/shapes#> .
@prefix garden: <https://w3id.org/aleph/garden#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Conformance test shipped alongside the vocabulary, so that anyone federating
# later checks against the same shapes without being sent anything.
#
# What is NOT here, on purpose: pair uniqueness of links, "exactly one placement
# per concept", and the chain condition between a transition's stabilityBefore
# and the card's current stability. All three span documents, which no shape can
# see, so the writer enforces them. A shape that cannot fail is worse than no
# shape — it reports success forever without checking anything.
#
# Target classes are listed one by one rather than relying on a superclass,
# because SHACL reads the class hierarchy from the data graph and a written
# document is not obliged to carry the vocabulary with it.

<https://w3id.org/aleph/garden/shapes>
    rdfs:label   "Aleph Garden shapes"@en ;
    rdfs:comment "SHACL conditions for the Aleph Garden vocabulary."@en ;
    dcterms:creator <https://toph.so/profile#me> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://w3id.org/aleph/garden#> .

#################################################################
# Placement
#################################################################

shapes:PlacementShape a sh:NodeShape ;
    sh:targetClass garden:Placement ;
    sh:property [
        sh:path garden:concept ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A placement binds exactly one concept. The concept may be a foreign IRI." ] ;
    sh:property [
        sh:path garden:ordinal ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ;
        sh:message "A placement needs exactly one ordinal, an integer of at least 1." ] ;
    sh:property [
        sh:path garden:form ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path garden:layout ; sh:maxCount 1 ] ;
    sh:property [
        sh:path schema:description ; sh:nodeKind sh:Literal ; sh:uniqueLang true ;
        sh:message "A place is described in prose, at most once per language." ] ;
    sh:property [
        sh:path garden:inscription ; sh:nodeKind sh:Literal ; sh:uniqueLang true ;
        sh:message "A place carries at most one inscription per language." ] ;
    sh:xone (
        [ sh:property [ sh:path garden:parent ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path garden:world  ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path garden:world  ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path garden:parent ; sh:maxCount 0 ] ]
    ) ;
    sh:message "A placement carries exactly one of garden:parent or garden:world — a region root hangs from the world, everything else from its parent." .

#################################################################
# World and layout
#################################################################

shapes:WorldShape a sh:NodeShape ;
    sh:targetClass garden:World ;
    sh:property [
        sh:path garden:layout ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "The world needs a layout — without it the arrangement of regions relative to each other is undefined." ] .

shapes:LayoutShape a sh:NodeShape ;
    sh:targetClass garden:Layout ;
    sh:targetObjectsOf garden:layout ;
    sh:property [
        sh:path garden:strategy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A layout names exactly one strategy." ] ;
    sh:property [
        sh:path garden:seed ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A layout carries at most one seed." ] ;
    sh:property [
        sh:path garden:locked ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "A layout states exactly once whether it is locked." ] .

shapes:LayoutStrategyShape a sh:NodeShape ;
    sh:targetClass garden:LayoutStrategy ;
    sh:property [
        sh:path garden:appendStable ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "A layout strategy must declare garden:appendStable — whether position(i) is independent of the total count." ] ;
    sh:property [
        sh:path garden:sourced ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "A layout strategy must declare garden:sourced — whether it draws positions from external data." ] ;
    sh:property [
        sh:path garden:implementation ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path garden:dimensions ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

#################################################################
# Link
#################################################################

shapes:LinkShape a sh:NodeShape ;
    sh:targetClass garden:Link ;
    sh:property [
        sh:path garden:from ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A link has exactly one source concept, and it is an IRI." ] ;
    sh:property [
        sh:path garden:to ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A link has exactly one target concept, and it is an IRI." ] ;
    sh:property [
        sh:path garden:relation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A link states exactly one relation. The relation sets the direction." ] ;
    sh:property [
        sh:path garden:from ; sh:disjoint garden:to ;
        sh:message "A link must connect two different concepts." ] ;
    sh:property [
        sh:path schema:description ; sh:nodeKind sh:Literal ; sh:uniqueLang true ;
        sh:message "A passage is described in prose, at most once per language." ] ;
    sh:property [
        sh:path garden:inscription ; sh:nodeKind sh:Literal ; sh:uniqueLang true ;
        sh:message "A passage carries at most one inscription per language." ] ;
    # The rule is written against links, not against skos:related. Associations
    # exist only as link resources, so no skos:related triple is ever
    # materialised and a check against it would pass forever without checking.
    #
    # The same trap applies on the other side, which is why this is a path and
    # not a lookup of skos:broaderTransitive: nobody runs a reasoner over a pod,
    # so the transitive closure is not in the data either.
    #
    # The path below is a MATERIALISED ARTEFACT, not a hand-maintained list. Its
    # single source is garden:conceptHierarchy in the vocabulary, which declares
    # the ascending and descending predicates; src/hierarchy.ts generates this
    # expression from that declaration and the acceptance run compares the two.
    # Edit the declaration and re-run the check, never this string alone.
    #
    # It is written out rather than substituted at load time because these
    # shapes have to work in a stock validator, with nobody's loader present.
    # SPARQL has no transitive closure over a predicate bound from data, so the
    # predicate set has to become a literal path somewhere; making it a checked
    # artefact keeps the declaration authoritative without shipping a file that
    # needs preprocessing first.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Hierarchy and association are disjoint in SKOS: two concepts already connected through broader/narrower must not also carry a link. Things sharing a room get no wormhole to each other." ;
        sh:select """
            SELECT $this ?value WHERE {
              $this <https://w3id.org/aleph/garden#from> ?a ;
                    <https://w3id.org/aleph/garden#to>   ?b .
              {
                ?a ( <http://www.w3.org/2004/02/skos/core#broader> | <http://www.w3.org/2004/02/skos/core#broaderTransitive> | ^<http://www.w3.org/2004/02/skos/core#narrower> | ^<http://www.w3.org/2004/02/skos/core#narrowerTransitive> )+ ?b .
              } UNION {
                ?b ( <http://www.w3.org/2004/02/skos/core#broader> | <http://www.w3.org/2004/02/skos/core#broaderTransitive> | ^<http://www.w3.org/2004/02/skos/core#narrower> | ^<http://www.w3.org/2004/02/skos/core#narrowerTransitive> )+ ?a .
              }
              BIND(?b AS ?value)
            }
        """ ] .

shapes:RelationShape a sh:NodeShape ;
    sh:targetObjectsOf garden:relation ;
    sh:in ( garden:prerequisiteFor garden:generalizes garden:contrastsWith garden:corresponds ) ;
    sh:message "A link relation is one of the four subproperties of skos:related the contract defines." .

#################################################################
# Route and stops
#################################################################

shapes:StopShape a sh:NodeShape ;
    sh:targetClass garden:Stop ;
    sh:property [
        sh:path garden:ordinal ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ;
        sh:message "A stop needs exactly one ordinal. A vacated stop keeps it, so the indices after it stand still." ] ;
    sh:property [
        sh:path garden:concept ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [
        sh:path garden:vacant ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:xone (
        [ sh:property [ sh:path garden:concept ; sh:minCount 1 ] ;
          sh:property [ sh:path garden:vacant  ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path garden:vacant  ; sh:minCount 1 ; sh:hasValue true ] ;
          sh:property [ sh:path garden:concept ; sh:maxCount 0 ] ]
    ) ;
    sh:message "A stop is either occupied by a concept or marked garden:vacant true — never both, never neither." .

shapes:RouteShape a sh:NodeShape ;
    sh:targetClass garden:Route ;
    sh:property [
        sh:path garden:stop ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A route has at least one stop." ] .

# The two ordinal conditions sit on shapes of their own rather than as two
# sh:sparql values on RouteShape. shacl-engine 1.1.2 collapses several
# sh:sparql constraints on one shape into a single always-failing result; one
# constraint per shape evaluates correctly. Splitting them costs nothing —
# targets are declarative, so both still apply to every route.

shapes:RouteOrdinalGapShape a sh:NodeShape ;
    sh:targetClass garden:Route ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Route stop ordinals run without gaps from 1. New stops get max + 1; inserting between is not provided for." ;
        sh:select """
            SELECT $this ?value WHERE {
              $this <https://w3id.org/aleph/garden#stop> ?stop .
              ?stop <https://w3id.org/aleph/garden#ordinal> ?value .
              FILTER( ?value > 1 )
              FILTER NOT EXISTS {
                $this <https://w3id.org/aleph/garden#stop> ?prev .
                ?prev <https://w3id.org/aleph/garden#ordinal> ?prevOrdinal .
                FILTER( ?prevOrdinal = ?value - 1 )
              }
            }
        """ ] .

shapes:RouteOrdinalStartShape a sh:NodeShape ;
    sh:targetClass garden:Route ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Route stop ordinals start at 1." ;
        sh:select """
            SELECT $this ?value WHERE {
              $this <https://w3id.org/aleph/garden#stop> ?value .
              FILTER NOT EXISTS {
                $this <https://w3id.org/aleph/garden#stop> ?first .
                ?first <https://w3id.org/aleph/garden#ordinal> 1 .
              }
            }
        """ ] .

#################################################################
# Cards
#
# The shared conditions are repeated per card class rather than hung on
# garden:Card, so that a card document validates on its own without carrying
# the vocabulary's subclass axioms along.
#################################################################

shapes:CardStateShape a sh:NodeShape ;
    sh:targetClass garden:PlaceCard, garden:ConceptCard, garden:LinkCard,
                   garden:RouteCard, garden:SequenceCard ;
    sh:property [
        sh:path garden:due ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "A card is scheduled exactly once." ] ;
    sh:property [
        sh:path garden:reps ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ;
        sh:message "reps is a single non-negative integer." ] ;
    sh:property [
        sh:path garden:lapses ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ;
        sh:message "lapses is a single non-negative integer." ] ;
    sh:property [
        sh:path garden:suspended ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [
        sh:path garden:lastTransition ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A card points at most once at the transition that produced its current state." ] .

# A new card has no scheduler state. FSRS separates "new" from "learnt", and the
# initial values only come into being at the first review, out of its rating —
# an unconditional requirement here would demand an invented stability and turn
# the first retrieval into a repetition.
#
# garden:lastReview belongs to the same condition rather than to the block
# above: once reviews have happened the moment has to be there, because without
# it the retrievability cannot be computed at all.
shapes:CardMemoryShape a sh:NodeShape ;
    sh:targetClass garden:PlaceCard, garden:ConceptCard, garden:LinkCard,
                   garden:RouteCard, garden:SequenceCard ;
    sh:xone (
        [ sh:property [ sh:path garden:reps       ; sh:hasValue 0 ] ;
          sh:property [ sh:path garden:stability  ; sh:maxCount 0 ] ;
          sh:property [ sh:path garden:difficulty ; sh:maxCount 0 ] ;
          sh:property [ sh:path garden:lastReview ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path garden:reps       ; sh:minExclusive 0 ] ;
          sh:property [ sh:path garden:stability  ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:datatype xsd:decimal ; sh:minExclusive 0.0 ] ;
          sh:property [ sh:path garden:difficulty ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:datatype xsd:decimal ; sh:minInclusive 1.0 ; sh:maxInclusive 10.0 ] ;
          sh:property [ sh:path garden:lastReview ; sh:minCount 1 ; sh:maxCount 1 ;
                        sh:datatype xsd:dateTime ] ]
    ) ;
    sh:message "A card with reps 0 carries neither stability, difficulty nor lastReview; from the first review on it carries exactly one of each — stability above zero, difficulty in [1, 10], and the moment the retrievability is measured from." .

shapes:PlaceCardShape a sh:NodeShape ;
    sh:targetClass garden:PlaceCard ;
    sh:property [ sh:path garden:concept  ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A place card reviews exactly one concept." ] ;
    sh:property [ sh:path garden:link     ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:route    ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:sequence ; sh:maxCount 0 ] .

shapes:ConceptCardShape a sh:NodeShape ;
    sh:targetClass garden:ConceptCard ;
    sh:property [ sh:path garden:concept  ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A concept card reviews exactly one concept." ] ;
    sh:property [ sh:path garden:link     ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:route    ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:sequence ; sh:maxCount 0 ] .

shapes:LinkCardShape a sh:NodeShape ;
    sh:targetClass garden:LinkCard ;
    sh:property [ sh:path garden:link ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A link card reviews exactly one connection." ] ;
    sh:property [ sh:path garden:direction ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( garden:forward garden:reverse ) ;
                  sh:message "A link card states which end it asks from — a connection is answerable from either." ] ;
    sh:property [ sh:path garden:concept  ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:route    ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:sequence ; sh:maxCount 0 ] .

shapes:RouteCardShape a sh:NodeShape ;
    sh:targetClass garden:RouteCard ;
    sh:property [ sh:path garden:route ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:message "A route card reviews exactly one route." ] ;
    sh:property [ sh:path garden:concept  ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:link     ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:sequence ; sh:maxCount 0 ] .

shapes:SequenceCardShape a sh:NodeShape ;
    sh:targetClass garden:SequenceCard ;
    sh:property [ sh:path garden:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "A sequence card recites exactly one sequence." ] ;
    sh:property [ sh:path garden:record ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path garden:concept ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:link    ; sh:maxCount 0 ] ;
    sh:property [ sh:path garden:route   ; sh:maxCount 0 ] .

#################################################################
# Transitions and pruning
#################################################################

shapes:TransitionShape a sh:NodeShape ;
    sh:targetClass garden:Transition, garden:Attempt, garden:Displacement ;
    sh:property [
        sh:path garden:card ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A transition applies to exactly one card." ] ;
    sh:property [
        sh:path schema:startTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "A transition happened at exactly one time." ] ;
    sh:property [
        sh:path schema:endTime ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [
        sh:path garden:stabilityAfter ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minExclusive 0.0 ;
        sh:message "A transition records the stability after it, greater than zero." ] ;
    sh:property [
        sh:path garden:difficultyAfter ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minInclusive 1.0 ; sh:maxInclusive 10.0 ;
        sh:message "A transition records the difficulty after it, in [1, 10]." ] ;
    sh:property [
        sh:path garden:stabilityBefore ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minExclusive 0.0 ;
        sh:message "A recorded stability before the transition is a single value greater than zero." ] ;
    sh:property [
        sh:path garden:difficultyBefore ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minInclusive 1.0 ; sh:maxInclusive 10.0 ;
        sh:message "A recorded difficulty before the transition is a single value in [1, 10]." ] .

# The before-state is what makes a suffix replayable, and stability alone is not
# enough: the stability update is a function of stability, difficulty,
# retrievability and rating, so a suffix without difficulty cannot be recomputed.
# The two therefore come as a pair.
#
# They come as an *optional* pair because a card with reps 0 has no state at all.
# The transition that takes a card out of that condition has nothing to record as
# "before", and demanding one would reintroduce the invented initial values that
# CardMemoryShape exists to avoid. Whether the absence is legitimate is a
# question about the card, which no shape can see from the transition document —
# the writer pairs the two up.
shapes:TransitionBeforeStateShape a sh:NodeShape ;
    sh:targetClass garden:Transition, garden:Attempt, garden:Displacement ;
    sh:xone (
        [ sh:property [ sh:path garden:stabilityBefore  ; sh:minCount 1 ] ;
          sh:property [ sh:path garden:difficultyBefore ; sh:minCount 1 ] ]
        [ sh:property [ sh:path garden:stabilityBefore  ; sh:maxCount 0 ] ;
          sh:property [ sh:path garden:difficultyBefore ; sh:maxCount 0 ] ]
    ) ;
    sh:message "stabilityBefore and difficultyBefore are recorded together or not at all — half a before-state cannot be replayed from." .

shapes:AttemptShape a sh:NodeShape ;
    sh:targetClass garden:Attempt ;
    sh:property [ sh:path garden:rating ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( garden:again garden:hard garden:good garden:easy ) ;
                  sh:message "An attempt carries exactly one rating from the contract's four." ] ;
    sh:property [ sh:path garden:latency ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ] ;
    sh:property [ sh:path garden:retrievability ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
    sh:property [ sh:path garden:reached  ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path garden:failedAt ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path garden:kind ; sh:maxCount 0 ;
                  sh:message "garden:kind belongs to a displacement. An attempt is a retrieval, not an intervention." ] .

shapes:StopTimingShape a sh:NodeShape ;
    sh:targetClass garden:StopTiming ;
    sh:targetObjectsOf garden:timing ;
    sh:property [ sh:path garden:ordinal ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path garden:latency ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ; sh:minInclusive 0.0 ] .

shapes:DisplacementShape a sh:NodeShape ;
    sh:targetClass garden:Displacement ;
    sh:property [ sh:path garden:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( garden:Move garden:Reskin garden:Relayout garden:Promotion ) ;
                  sh:message "A displacement names exactly one of the four interventions." ] ;
    sh:property [ sh:path garden:rating ; sh:maxCount 0 ;
                  sh:message "A displacement has no rating. It records a decision, not a retrieval, and must not read as a review to a later parameter fit." ] .

shapes:PruningShape a sh:NodeShape ;
    sh:targetClass garden:Pruning ;
    sh:property [
        sh:path garden:card ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A pruning record belongs to exactly one card — it is the receipt, not the decision." ] ;
    sh:property [
        sh:path garden:prunedBefore ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "A pruning record states exactly one cut-off." ] ;
    sh:property [
        sh:path garden:prunedCount ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ;
        sh:message "A pruning record states how many transitions it removed, at least one." ] ;
    sh:property [
        sh:path schema:startTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

#################################################################
# Concepts
#################################################################

shapes:ConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ;
        sh:message "A concept carries exactly one preferred label per language." ] ;
    sh:property [
        sh:path skos:inScheme ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A concept states which scheme it belongs to." ] .
