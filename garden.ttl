@prefix garden: <https://w3id.org/aleph/garden#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# The Aleph Garden vocabulary: places, connections, routes, presentation, and
# the review scheduler that turns generated terrain into usable loci.
#
# RDFS carries the taxonomy, SHACL carries the conditions. There is deliberately
# no OWL here: open-world semantics describes, it does not constrain, and every
# cardinality this contract cares about is a "more than this is an error"
# statement rather than an identity statement.
#
# Identity is an IRI, implementation is a URL. Terms are minted under
# https://w3id.org/aleph/garden# and never under the application's own domain,
# so an implementation may move and an identity may not.

<https://w3id.org/aleph/garden#>
    rdfs:label   "Aleph Garden vocabulary"@en ;
    rdfs:comment "Terms for placing concepts in a walkable garden, connecting them, routing through them, and scheduling their review."@en ;
    rdfs:seeAlso <https://w3id.org/aleph/garden/shapes> .

#################################################################
# Classes
#################################################################

garden:World a rdfs:Class ;
    rdfs:subClassOf schema:Place ;
    rdfs:label   "World"@en ;
    rdfs:comment "The single root that holds the topmost ordering. Without it the arrangement of regions relative to each other is undefined, while connections are supposed to point in the true spatial direction of their counterpart."@en .

garden:Placement a rdfs:Class ;
    rdfs:subClassOf schema:Place ;
    rdfs:label   "Placement"@en ;
    rdfs:comment "Binds a concept to a place. Exactly one per concept, permanent. Holds a parent and an ordinal; where that lands in the image is decided by a layout strategy, never by stored coordinates."@en .

garden:Layout a rdfs:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label   "Layout"@en ;
    rdfs:comment "The arrangement of one place's children: a strategy, an optional seed, and whether the seed is frozen. Set per place, frozen per place."@en .

garden:LayoutStrategy a rdfs:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label   "Layout strategy"@en ;
    rdfs:comment "A function from index to position, identified by IRI and implemented at a URL."@en .

garden:Link a rdfs:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label   "Link"@en ;
    rdfs:comment "A directed connection between two concepts, addressable so that it can carry content of its own. A link with children is a place; a link without children is a passage. That is a fact about the graph, not a settable property."@en .

garden:Route a rdfs:Class ;
    rdfs:subClassOf schema:ItemList ;
    rdfs:label   "Route"@en ;
    rdfs:comment "An ordered sequence of stops laid through the terrain. Route membership is the loci marking; cards are scheduler state."@en .

garden:Stop a rdfs:Class ;
    rdfs:subClassOf schema:ListItem ;
    rdfs:label   "Stop"@en ;
    rdfs:comment "One station of a route. A named resource with an ordinal rather than a list member, so that vacating a stop keeps the indices after it intact."@en .

garden:Card a rdfs:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label   "Card"@en ;
    rdfs:comment "Scheduler state for one reviewable item. Abstract; use one of the five concrete card types."@en .

garden:PlaceCard a rdfs:Class ;
    rdfs:subClassOf garden:Card ;
    rdfs:label   "Place card"@en ;
    rdfs:comment "Place to concept: standing somewhere and reading off what lies there. Self-graded."@en .

garden:ConceptCard a rdfs:Class ;
    rdfs:subClassOf garden:Card ;
    rdfs:label   "Concept card"@en ;
    rdfs:comment "Concept to place: direct addressing. Self-graded. Independent state from the place card for the same concept — recall in one direction says nothing about the other."@en .

garden:LinkCard a rdfs:Class ;
    rdfs:subClassOf garden:Card ;
    rdfs:label   "Link card"@en ;
    rdfs:comment "Connection to destination. Self-graded. Carries a direction, because a connection is answerable from either end."@en .

garden:RouteCard a rdfs:Class ;
    rdfs:subClassOf garden:Card ;
    rdfs:label   "Route card"@en ;
    rdfs:comment "Walking a route end to end. Graded by latency, not by a record ratio: a route has fixed length, so a record ratio saturates after the first full walk."@en .

garden:SequenceCard a rdfs:Class ;
    rdfs:subClassOf garden:Card ;
    rdfs:label   "Sequence card"@en ;
    rdfs:comment "Reciting a character sequence. Graded against the previous record, which works here because the sequence is unbounded."@en .

garden:Transition a rdfs:Class ;
    rdfs:subClassOf schema:Action ;
    rdfs:label   "Transition"@en ;
    rdfs:comment "A state change at a card. Records the stability before and after, which makes every suffix of the log replayable from its own first stabilityBefore."@en .

garden:Attempt a rdfs:Class ;
    rdfs:subClassOf garden:Transition ;
    rdfs:label   "Attempt"@en ;
    rdfs:comment "A transition that follows from a retrieval."@en .

garden:Displacement a rdfs:Class ;
    rdfs:subClassOf garden:Transition ;
    rdfs:label   "Displacement"@en ;
    rdfs:comment "A transition that follows from an intervention — a move, a re-skin, a layout change or a promotion. Logs a decision rather than a retrieval, and is deliberately not an attempt so that a later parameter fit does not read it as a review."@en .

garden:StopTiming a rdfs:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label   "Stop timing"@en ;
    rdfs:comment "The latency recorded at one stop of a walked route."@en .

garden:Pruning a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label   "Pruning"@en ;
    rdfs:comment "A record that transition history before a cut-off was removed. Without it a pruned history looks like a card that came into existence later than it did — the log would lie silently about its own completeness."@en .

#################################################################
# World, placement and hierarchy
#################################################################

garden:layout a rdf:Property ;
    rdfs:label   "layout"@en ;
    rdfs:comment "The arrangement applied to this place's children."@en ;
    rdfs:range   garden:Layout .

garden:concept a rdf:Property ;
    rdfs:label   "concept"@en ;
    rdfs:comment "The concept placed here, reviewed by this card, or visited at this stop. May be a foreign IRI; no local copy is minted."@en ;
    rdfs:range   skos:Concept .

garden:parent a rdf:Property ;
    rdfs:label   "parent"@en ;
    rdfs:comment "The place this one sits inside. Absent exactly on a region root, which carries garden:world instead. Single-valued, which is why it cannot simply follow skos:broader: the concept graph is a DAG and the placement structure is a forest, so a placement is a projection of the one onto the other and not a copy of it."@en .

garden:world a rdf:Property ;
    rdfs:label   "world"@en ;
    rdfs:comment "The world a region root hangs from."@en ;
    rdfs:range   garden:World .

garden:ordinal a rdf:Property ;
    rdfs:label   "ordinal"@en ;
    rdfs:comment "Position among siblings, unique under the same parent, starting at 1. Forms the default route through that place. New entries get max + 1; nothing is ever renumbered."@en ;
    rdfs:range   xsd:integer .

garden:form a rdf:Property ;
    rdfs:label   "form"@en ;
    rdfs:comment "The catalogue entry this place is drawn as. A form carries the binding to its rendering as a URL, so the renderer holds no table of special cases."@en ;
    rdfs:range   skos:Concept .

#################################################################
# Layout strategies
#################################################################

garden:strategy a rdf:Property ;
    rdfs:label   "strategy"@en ;
    rdfs:comment "The layout strategy used."@en ;
    rdfs:range   garden:LayoutStrategy .

garden:seed a rdf:Property ;
    rdfs:label   "seed"@en ;
    rdfs:comment "The seed the strategy is evaluated with. Re-rollable until locked."@en ;
    rdfs:range   xsd:string .

garden:locked a rdf:Property ;
    rdfs:label   "locked"@en ;
    rdfs:comment "Whether the seed is frozen. A locked layout rejects further seed changes."@en ;
    rdfs:range   xsd:boolean .

garden:implementation a rdf:Property ;
    rdfs:label   "implementation"@en ;
    rdfs:comment "Where the code behind this identity is fetched from. Whether an ESM module or a WASM plugin lies there is a property of the URL, not of the garden."@en .

garden:dimensions a rdf:Property ;
    rdfs:label   "dimensions"@en ;
    rdfs:comment "How many spatial dimensions the strategy emits."@en ;
    rdfs:range   xsd:integer .

garden:appendStable a rdf:Property ;
    rdfs:label   "append stable"@en ;
    rdfs:comment "Normative. True when position(i) does not depend on the total number of elements. A grid with a fixed column count qualifies; a grid that rewraps to stay square does not, because element 26 moves the 25 before it. Switching a place onto a non-append-stable strategy displaces every child at once."@en ;
    rdfs:range   xsd:boolean .

garden:sourced a rdf:Property ;
    rdfs:label   "sourced"@en ;
    rdfs:comment "Normative. True when the strategy draws positions from external data. Such a strategy must be materialised on first use — layout and backdrop together — because external sources are authoring inputs, never live views."@en ;
    rdfs:range   xsd:boolean .

#################################################################
# Links
#################################################################

garden:from a rdf:Property ;
    rdfs:label   "from"@en ;
    rdfs:comment "Source concept of a connection. Points at a concept rather than a placement, so that re-sorting the terrain is not also an edit to the connections."@en ;
    rdfs:range   skos:Concept .

garden:to a rdf:Property ;
    rdfs:label   "to"@en ;
    rdfs:comment "Target concept of a connection."@en ;
    rdfs:range   skos:Concept .

garden:relation a rdf:Property ;
    rdfs:label   "relation"@en ;
    rdfs:comment "Which kind of association this connection asserts. The relation sets the direction; IRI ordering does not."@en ;
    rdfs:range   rdf:Property .

garden:prerequisiteFor a rdf:Property ;
    rdfs:subPropertyOf skos:related ;
    rdfs:label   "prerequisite for"@en ;
    rdfs:comment "The source has to be held before the target can be understood. Directed."@en .

garden:generalizes a rdf:Property ;
    rdfs:subPropertyOf skos:related ;
    rdfs:label   "generalizes"@en ;
    rdfs:comment "The source is the general case of which the target is an application. Directed."@en .

garden:contrastsWith a rdf:Property ;
    rdfs:subPropertyOf skos:related ;
    rdfs:label   "contrasts with"@en ;
    rdfs:comment "The two are learned against each other. Symmetric in meaning, so the writer stores the direction whose source IRI sorts lower."@en .

#################################################################
# Routes
#################################################################

garden:purpose a rdf:Property ;
    rdfs:label   "purpose"@en ;
    rdfs:comment "What this route is for, in the author's words."@en .

garden:stop a rdf:Property ;
    rdfs:label   "stop"@en ;
    rdfs:comment "A station of this route."@en ;
    rdfs:range   garden:Stop .

garden:vacant a rdf:Property ;
    rdfs:label   "vacant"@en ;
    rdfs:comment "True on a stop that has been emptied. The stop keeps its ordinal so the indices after it stand still, and vacant stops do not count towards garden:reached."@en ;
    rdfs:range   xsd:boolean .

#################################################################
# Cards
#################################################################

garden:link a rdf:Property ;
    rdfs:label   "link"@en ;
    rdfs:comment "The connection a link card reviews."@en ;
    rdfs:range   garden:Link .

garden:route a rdf:Property ;
    rdfs:label   "route"@en ;
    rdfs:comment "The route a route card reviews."@en ;
    rdfs:range   garden:Route .

garden:sequence a rdf:Property ;
    rdfs:label   "sequence"@en ;
    rdfs:comment "The character sequence a sequence card recites."@en ;
    rdfs:range   xsd:string .

garden:record a rdf:Property ;
    rdfs:label   "record"@en ;
    rdfs:comment "The longest run reached on a sequence card so far, updated to max(record, n) after every session and read before the session it grades. Kept on the card next to the scheduler state rather than reconstructed from history, because it is the basis the grading is measured against and history may have been pruned."@en ;
    rdfs:range   xsd:integer .

garden:direction a rdf:Property ;
    rdfs:label   "direction"@en ;
    rdfs:comment "Which end of the connection a link card asks from."@en ;
    rdfs:range   skos:Concept .

garden:stability a rdf:Property ;
    rdfs:label   "stability"@en ;
    rdfs:comment "FSRS memory stability in days. Authoritative card state, patched rather than recomputed from history."@en ;
    rdfs:range   xsd:decimal .

garden:difficulty a rdf:Property ;
    rdfs:label   "difficulty"@en ;
    rdfs:comment "FSRS difficulty in [1, 10]. Survives a displacement — moving a place does not make its concept harder."@en ;
    rdfs:range   xsd:decimal .

garden:due a rdf:Property ;
    rdfs:label   "due"@en ;
    rdfs:comment "When this card is next scheduled."@en ;
    rdfs:range   xsd:dateTime .

garden:reps a rdf:Property ;
    rdfs:label   "reps"@en ;
    rdfs:comment "Number of reviews. Unchanged by a displacement, which is not a review."@en ;
    rdfs:range   xsd:integer .

garden:lapses a rdf:Property ;
    rdfs:label   "lapses"@en ;
    rdfs:comment "Number of failed reviews. Unchanged by a displacement, which is not a failed retrieval."@en ;
    rdfs:range   xsd:integer .

garden:suspended a rdf:Property ;
    rdfs:label   "suspended"@en ;
    rdfs:comment "Pauses a card without deleting it. Deleting would be the only way to lose history, and would make 'paused' indistinguishable from 'never marked'."@en ;
    rdfs:range   xsd:boolean .

garden:lastTransition a rdf:Property ;
    rdfs:label   "last transition"@en ;
    rdfs:comment "The transition that produced the card's current state. Applying that same transition again is a no-op, which makes a retried patch after a failure safe."@en ;
    rdfs:range   garden:Transition .

garden:lastReview a rdf:Property ;
    rdfs:label   "last review"@en ;
    rdfs:comment "When this card last changed state. Kept on the card rather than read out of the last transition, because FSRS needs the elapsed days for retrievability and deriving them from the log breaks exactly when a log has been pruned away entirely — the case pruning exists for."@en ;
    rdfs:range   xsd:dateTime .

#################################################################
# Transitions
#################################################################

garden:card a rdf:Property ;
    rdfs:subPropertyOf schema:object ;
    rdfs:label   "card"@en ;
    rdfs:comment "The card this transition or pruning record applies to."@en ;
    rdfs:range   garden:Card .

garden:kind a rdf:Property ;
    rdfs:label   "kind"@en ;
    rdfs:comment "Which intervention a displacement records."@en ;
    rdfs:range   skos:Concept .

garden:stabilityBefore a rdf:Property ;
    rdfs:label   "stability before"@en ;
    rdfs:comment "The card's stability immediately before this transition. Also the conflict check: a transition whose stabilityBefore does not match the card's current stability is a detectable conflict rather than silent corruption. Absent on the transition that takes a new card out of its stateless condition — there was no stability to record."@en ;
    rdfs:range   xsd:decimal .

garden:stabilityAfter a rdf:Property ;
    rdfs:label   "stability after"@en ;
    rdfs:comment "The card's stability immediately after this transition."@en ;
    rdfs:range   xsd:decimal .

garden:difficultyBefore a rdf:Property ;
    rdfs:label   "difficulty before"@en ;
    rdfs:comment "The card's difficulty immediately before this transition. Not decoration: the stability update is a function of stability, difficulty, retrievability and rating, so without a recorded difficulty a suffix of the log cannot be recomputed and the replay guarantee is false. Absent together with garden:stabilityBefore on a new card's first transition."@en ;
    rdfs:range   xsd:decimal .

garden:difficultyAfter a rdf:Property ;
    rdfs:label   "difficulty after"@en ;
    rdfs:comment "The card's difficulty immediately after this transition."@en ;
    rdfs:range   xsd:decimal .

garden:rating a rdf:Property ;
    rdfs:label   "rating"@en ;
    rdfs:comment "The grade this attempt was scored as."@en ;
    rdfs:range   skos:Concept .

garden:latency a rdf:Property ;
    rdfs:label   "latency"@en ;
    rdfs:comment "Total recall time in seconds for this attempt."@en ;
    rdfs:range   xsd:decimal .

garden:timing a rdf:Property ;
    rdfs:label   "timing"@en ;
    rdfs:comment "A per-station duration of a walked route. A route card needs these beyond the total, because its rating comes out of the retrieval behaviour across the sequence rather than out of a sum."@en ;
    rdfs:range   garden:StopTiming .

garden:reached a rdf:Property ;
    rdfs:label   "reached"@en ;
    rdfs:comment "How many stations were answered. Vacant stops do not count."@en ;
    rdfs:range   xsd:integer .

garden:failedAt a rdf:Property ;
    rdfs:label   "failed at"@en ;
    rdfs:comment "The ordinal of the station the walk broke off at. Absent on a complete walk."@en ;
    rdfs:range   xsd:integer .

garden:retrievability a rdf:Property ;
    rdfs:label   "retrievability"@en ;
    rdfs:comment "Predicted recall probability at review time."@en ;
    rdfs:range   xsd:decimal .

garden:prunedBefore a rdf:Property ;
    rdfs:label   "pruned before"@en ;
    rdfs:comment "The cut-off; transitions starting before this were removed."@en ;
    rdfs:range   xsd:dateTime .

garden:prunedCount a rdf:Property ;
    rdfs:label   "pruned count"@en ;
    rdfs:comment "How many transitions the cut removed."@en ;
    rdfs:range   xsd:integer .

#################################################################
# Hierarchy topology
#
# Which predicates make one concept an ancestor of another, stated once here
# rather than repeated by each consumer. Three of them are known: the SHACL
# rule that keeps hierarchy and association disjoint, depth derivation in the
# garden, and later an agent asking whether a concept lies anywhere below
# another. Each of those has to walk the same edges, and three copies of the
# predicate list would drift.
#
# Two directions, because SKOS supplies both and a pod carries whichever the
# author wrote: an ascending predicate is followed forwards to reach an
# ancestor, a descending one is followed backwards. Neither closure is
# materialised in a pod — nobody runs a reasoner over one — so a consumer
# traverses these edges itself rather than trusting skos:broaderTransitive to
# be present.
#################################################################

garden:ascendingVia a rdf:Property ;
    rdfs:label   "ascending via"@en ;
    rdfs:comment "A predicate that points from a concept towards a broader one, to be followed forwards when climbing."@en ;
    rdfs:range   rdf:Property .

garden:descendingVia a rdf:Property ;
    rdfs:label   "descending via"@en ;
    rdfs:comment "A predicate that points from a concept towards a narrower one, to be followed backwards when climbing."@en ;
    rdfs:range   rdf:Property .

garden:conceptHierarchy
    rdfs:label   "Concept hierarchy"@en ;
    rdfs:comment "The edge set over which one concept counts as an ancestor of another. The transitive closure of these edges is the hierarchy; garden:parent is a single-valued projection of it, which is why the concept graph is a DAG while the placement structure is a forest."@en ;
    garden:ascendingVia  skos:broader, skos:broaderTransitive ;
    garden:descendingVia skos:narrower, skos:narrowerTransitive .

#################################################################
# Enumerations
#
# One closed scheme shipped with the contract. Not to be confused with the
# subject schemes in a pod: those are user data and open, these are part of the
# contract. The vocabulary defines terms about places; it defines no subjects.
#################################################################

garden:enumerations a skos:ConceptScheme ;
    rdfs:label   "Aleph Garden enumerations"@en ;
    rdfs:comment "The closed value sets of the contract: forms, layout strategies, ratings, displacement kinds and link-card directions."@en .

garden:forms a skos:Collection ;
    rdfs:label "Form catalogue"@en ;
    rdfs:comment "Deliberately minimal in phase 0. Every entry carries the binding to its rendering as a URL."@en ;
    skos:member <https://w3id.org/aleph/garden/form/book>,
                <https://w3id.org/aleph/garden/form/table>,
                <https://w3id.org/aleph/garden/form/drawer>,
                <https://w3id.org/aleph/garden/form/cabinet>,
                <https://w3id.org/aleph/garden/form/lantern>,
                <https://w3id.org/aleph/garden/form/gate>,
                <https://w3id.org/aleph/garden/form/stone> .

<https://w3id.org/aleph/garden/form/book> a skos:Concept ;
    skos:inScheme garden:enumerations ; schema:name "Book"@en ;
    garden:implementation <https://aph.gdn/forms/book.js> .

<https://w3id.org/aleph/garden/form/table> a skos:Concept ;
    skos:inScheme garden:enumerations ; schema:name "Table"@en ;
    garden:implementation <https://aph.gdn/forms/table.js> .

<https://w3id.org/aleph/garden/form/drawer> a skos:Concept ;
    skos:inScheme garden:enumerations ; schema:name "Drawer"@en ;
    garden:implementation <https://aph.gdn/forms/drawer.js> .

<https://w3id.org/aleph/garden/form/cabinet> a skos:Concept ;
    skos:inScheme garden:enumerations ; schema:name "Cabinet"@en ;
    garden:implementation <https://aph.gdn/forms/cabinet.js> .

<https://w3id.org/aleph/garden/form/lantern> a skos:Concept ;
    skos:inScheme garden:enumerations ; schema:name "Lantern"@en ;
    garden:implementation <https://aph.gdn/forms/lantern.js> .

<https://w3id.org/aleph/garden/form/gate> a skos:Concept ;
    skos:inScheme garden:enumerations ; schema:name "Gate"@en ;
    garden:implementation <https://aph.gdn/forms/gate.js> .

<https://w3id.org/aleph/garden/form/stone> a skos:Concept ;
    skos:inScheme garden:enumerations ; schema:name "Stone"@en ;
    garden:implementation <https://aph.gdn/forms/stone.js> .

garden:layoutStrategies a skos:Collection ;
    rdfs:label "Layout strategies"@en ;
    skos:member <https://w3id.org/aleph/garden/layout/gosper>,
                <https://w3id.org/aleph/garden/layout/grid>,
                <https://w3id.org/aleph/garden/layout/square> .

<https://w3id.org/aleph/garden/layout/gosper> a skos:Concept, garden:LayoutStrategy ;
    skos:inScheme garden:enumerations ; schema:name "Gosper curve"@en ;
    rdfs:comment "A plane-filling curve. Adjacency along the curve is adjacency in the plane, so it supplies the world's canonical ordering and preserves locality for free."@en ;
    garden:implementation <https://aph.gdn/layouts/gosper.js> ;
    garden:dimensions    2 ;
    garden:appendStable  true ;
    garden:sourced       false .

<https://w3id.org/aleph/garden/layout/grid> a skos:Concept, garden:LayoutStrategy ;
    skos:inScheme garden:enumerations ; schema:name "Grid"@en ;
    rdfs:comment "Fixed column count, so index i keeps its cell however many siblings arrive."@en ;
    garden:implementation <https://aph.gdn/layouts/grid.js> ;
    garden:dimensions    2 ;
    garden:appendStable  true ;
    garden:sourced       false .

<https://w3id.org/aleph/garden/layout/square> a skos:Concept, garden:LayoutStrategy ;
    skos:inScheme garden:enumerations ; schema:name "Square grid"@en ;
    rdfs:comment "Rewraps to stay square, so the column count follows the total count. Admissible, but moving a place onto it relocates every child at once and is priced accordingly."@en ;
    garden:implementation <https://aph.gdn/layouts/square.js> ;
    garden:dimensions    2 ;
    garden:appendStable  false ;
    garden:sourced       false .

garden:ratings a skos:Collection ;
    rdfs:label "Ratings"@en ;
    rdfs:comment "Carried numerically as skos:notation, because the scheduler computes with the number."@en ;
    skos:member garden:again, garden:hard, garden:good, garden:easy .

garden:again a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Again"@en ; skos:notation "1"^^xsd:integer .
garden:hard  a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Hard"@en  ; skos:notation "2"^^xsd:integer .
garden:good  a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Good"@en  ; skos:notation "3"^^xsd:integer .
garden:easy  a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Easy"@en  ; skos:notation "4"^^xsd:integer .

garden:displacementKinds a skos:Collection ;
    rdfs:label "Displacement kinds"@en ;
    rdfs:comment "Moving, re-skinning, re-laying-out and promoting are one operation with four faces. The question is always whether memory has accrued, and if so what the change costs."@en ;
    skos:member garden:Move, garden:Reskin, garden:Relayout, garden:Promotion .

garden:Move a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Move"@en ;
    rdfs:comment "The place changed parent or ordinal."@en .
garden:Reskin a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Re-skin"@en ;
    rdfs:comment "The place kept its position and changed its form."@en .
garden:Relayout a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Re-layout"@en ;
    rdfs:comment "The parent's layout changed such that this child's position moved."@en .
garden:Promotion a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Promotion"@en ;
    rdfs:comment "The place was pulled onto a route and given the distinctness it was never allotted."@en .

garden:directions a skos:Collection ;
    rdfs:label "Link card directions"@en ;
    skos:member garden:forward, garden:reverse .

garden:forward a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Forward"@en ;
    rdfs:comment "Asked from the connection's source end: given from, name to."@en .
garden:reverse a skos:Concept ; skos:inScheme garden:enumerations ;
    schema:name "Reverse"@en ;
    rdfs:comment "Asked from the connection's target end: given to, name from."@en .
