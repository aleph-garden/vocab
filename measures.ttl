#################################################################
# Hand measures — the portion a thing is sold in
#
# A shopping list asks for two tins of tomatoes and no weight, and the amount
# stays unweighable until someone reads the label. That keeps these out of the
# measured shape and in here.
#################################################################

measures:can a skos:Concept, food:HandMeasure ;
    skos:inScheme measures:handMeasures ;
    skos:prefLabel "Dose"@de, "can"@en ;
    food:countForm
        [ food:pluralCategory "one"   ; skos:prefLabel "Dose"@de,  "can"@en ] ,
        [ food:pluralCategory "other" ; skos:prefLabel "Dosen"@de, "cans"@en ] .

measures:jar a skos:Concept, food:HandMeasure ;
    skos:inScheme measures:handMeasures ;
    skos:prefLabel "Glas"@de, "jar"@en ;
    food:countForm
        [ food:pluralCategory "one"   ; skos:prefLabel "Glas"@de,   "jar"@en ] ,
        [ food:pluralCategory "other" ; skos:prefLabel "Gläser"@de, "jars"@en ] .

measures:pack a skos:Concept, food:HandMeasure ;
    skos:inScheme measures:handMeasures ;
    skos:prefLabel "Packung"@de, "pack"@en ;
    food:countForm
        [ food:pluralCategory "one"   ; skos:prefLabel "Packung"@de,  "pack"@en ] ,
        [ food:pluralCategory "other" ; skos:prefLabel "Packungen"@de, "packs"@en ] .

#################################################################
# Open amounts
#
# No forms per count here: nothing stands in front of these to agree with.
#################################################################

measures:toTaste a skos:Concept, food:OpenAmount ;
    skos:inScheme measures:openAmounts ;
    skos:prefLabel "nach Geschmack"@de, "to taste"@en .

measures:asNeeded a skos:Concept, food:OpenAmount ;
    skos:inScheme measures:openAmounts ;
    skos:prefLabel "nach Bedarf"@de, "as needed"@en .

measures:forFrying a skos:Concept, food:OpenAmount ;
    skos:inScheme measures:openAmounts ;
    skos:prefLabel "zum Braten"@de, "for frying"@en .

measures:forGreasing a skos:Concept, food:OpenAmount ;
    skos:inScheme measures:openAmounts ;
    skos:prefLabel "zum Einfetten"@de, "for greasing"@en .

measures:forServing a skos:Concept, food:OpenAmount ;
    skos:inScheme measures:openAmounts ;
    skos:prefLabel "zum Servieren"@de, "for serving"@en .
